[{"id":"bench-press","name":"BARBELL BENCH PRESS","category":["Chest","Arms"],"equipment":"Barbell, Bench","duration":25,"calories":180,"rating":4.8,"difficulty":"Intermediate","sets":4,"reps":"6-8","description":"A compound press that builds chest thickness, triceps, and pressing power from a stable bench.","image":"/images/bicep-curl.jpg","instructions":["Set the bar over your eyes and plant both feet firmly.","Lower the bar to the lower chest with control.","Press upward while keeping your shoulder blades stable.","Rack the bar safely after your final rep."]},{"id":"back-squat","name":"BARBELL BACK SQUAT","category":["Legs","Glutes"],"equipment":"Barbell, Rack","duration":32,"calories":260,"rating":4.9,"difficulty":"Advanced","sets":4,"reps":"5-8","description":"A foundational lower-body lift for building leg strength, bracing control, and total-body power.","image":"/images/barbell-squat.jpg","instructions":["Set the bar securely across your upper back.","Brace your core and sit down between your hips.","Drive through the floor to stand tall.","Re-rack the bar after completing the set."]},{"id":"deadlift","name":"CONVENTIONAL DEADLIFT","category":["Back","Legs"],"equipment":"Barbell","duration":28,"calories":240,"rating":4.9,"difficulty":"Advanced","sets":4,"reps":"4-6","description":"A full-body pull that develops posterior-chain strength and powerful hip extension.","image":"/images/barbell-bench.jpg","instructions":["Stand with feet under the bar and grip just outside your legs.","Brace hard and keep the bar close.","Push the floor away and extend your hips.","Lower the bar under control."]},{"id":"overhead-press","name":"OVERHEAD PRESS","category":["Shoulders","Arms"],"equipment":"Barbell","duration":22,"calories":150,"rating":4.7,"difficulty":"Intermediate","sets":4,"reps":"6-10","description":"A strict vertical press for strong shoulders, triceps, and overhead stability.","image":"/images/overhead-press.jpg","instructions":["Start with the bar at upper chest height.","Brace your core and squeeze your glutes.","Press the bar overhead without leaning back.","Lower slowly to the starting position."]},{"id":"pull-up","name":"WEIGHTED PULL-UP","category":["Back","Arms"],"equipment":"Pull-up Bar","duration":20,"calories":145,"rating":4.8,"difficulty":"Advanced","sets":4,"reps":"5-8","description":"A demanding vertical pull that builds lats, upper back, and grip strength.","image":"/images/pull-up.jpg","instructions":["Grip the bar slightly wider than shoulder width.","Pull your shoulders down and back.","Drive elbows toward your ribs.","Lower until your arms are straight."]},{"id":"incline-press","name":"INCLINE DUMBBELL PRESS","category":["Chest","Shoulders"],"equipment":"Dumbbells, Bench","duration":24,"calories":175,"rating":4.7,"difficulty":"Intermediate","sets":4,"reps":"8-10","description":"An upper-chest focused press using dumbbells for balanced range of motion.","image":"/images/dips.jpg","instructions":["Set the bench to a moderate incline.","Start dumbbells beside your chest.","Press up and slightly inward.","Lower with a controlled stretch."]},{"id":"romanian-deadlift","name":"ROMANIAN DEADLIFT","category":["Hamstrings","Glutes"],"equipment":"Barbell","duration":26,"calories":210,"rating":4.8,"difficulty":"Intermediate","sets":3,"reps":"8-10","description":"A controlled hip hinge that loads the hamstrings and glutes through a long range.","image":"/images/lateral-raise.jpg","instructions":["Stand tall with the bar against your thighs.","Push hips back while keeping the back neutral.","Stop when hamstrings are fully loaded.","Drive hips forward to stand."]},{"id":"cable-row","name":"SEATED CABLE ROW","category":["Back","Biceps"],"equipment":"Cable Machine","duration":21,"calories":140,"rating":4.6,"difficulty":"Beginner","sets":3,"reps":"10-12","description":"A stable horizontal pull for mid-back thickness, lats, and biceps.","image":"/images/lat-pulldown.jpg","instructions":["Sit tall and brace your feet.","Pull the handle toward your lower ribs.","Pause and squeeze your shoulder blades.","Return slowly without rounding your back."]},{"id":"lunges","name":"DUMBBELL WALKING LUNGES","category":["Legs","Glutes"],"equipment":"Dumbbells","duration":27,"calories":220,"rating":4.7,"difficulty":"Intermediate","sets":3,"reps":"10/leg","description":"A unilateral leg builder that challenges balance, glutes, and quad endurance.","image":"/images/lunges.jpg","instructions":["Hold dumbbells at your sides.","Step forward into a controlled lunge.","Push through the front foot to stand.","Alternate legs for each rep."]},{"id":"biceps-curl","name":"DUMBBELL BICEPS CURL","category":["Arms","Biceps"],"equipment":"Dumbbells","duration":18,"calories":110,"rating":4.5,"difficulty":"Beginner","sets":3,"reps":"10-12","description":"A simple arm isolation movement that keeps tension on the biceps.","image":"/images/leg-curl.jpg","instructions":["Stand tall with palms facing forward.","Curl without swinging your torso.","Squeeze the biceps at the top.","Lower slowly until arms are straight."]},{"id":"triceps-pushdown","name":"CABLE TRICEPS PUSHDOWN","category":["Arms","Triceps"],"equipment":"Cable Machine","duration":17,"calories":105,"rating":4.6,"difficulty":"Beginner","sets":3,"reps":"10-15","description":"A focused triceps movement with constant cable tension.","image":"/images/plank.jpg","instructions":["Set the cable around upper-chest height.","Keep elbows tucked to your sides.","Push the handle down until arms are straight.","Return slowly without moving the elbows."]},{"id":"russian-twist","name":"RUSSIAN TWIST","category":["Core","Abs"],"equipment":"Medicine Ball","duration":15,"calories":95,"rating":4.4,"difficulty":"Beginner","sets":3,"reps":"16-20","description":"A rotational core drill that trains trunk control and endurance.","image":"/images/russian-twist.jpg","instructions":["Sit with knees bent and chest tall.","Hold the medicine ball close to your torso.","Rotate from side to side under control.","Keep your core braced throughout."]}]